<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:padding="32dp"
    android:gravity="center">

    <!-- Logo / Title -->
    <TextView
        android:text="M3R"
        android:textColor="@color/accent_cyan"
        android:textSize="64sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"/>

    <TextView
        android:text="WALLET"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:letterSpacing="0.4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:background="@color/accent_cyan"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:text="Secure · Decentralized · Fast"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"/>

    <!-- Buttons -->
    <Button
        android:id="@+id/btnCreateWallet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Create New Wallet"
        android:textColor="@color/bg_primary"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_cyan"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.Button"/>

    <Button
        android:id="@+id/btnImportWallet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Import Existing Wallet"
        android:textColor="@color/text_primary"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/border"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

    <TextView
        android:text="Your keys, your coins. M3R Wallet never stores your private key on any server."
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"/>

</LinearLayout>
