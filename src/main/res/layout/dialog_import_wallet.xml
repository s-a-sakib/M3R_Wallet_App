<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:text="Enter mnemonic phrase (12/24 words) or custom seed phrase"
        android:textColor="@color/text_secondary" android:textSize="13sp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etMnemonicOrKey"
        android:layout_width="match_parent" android:layout_height="100dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Enter mnemonic / seed phrase..."
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp"
        android:gravity="top" android:inputType="textMultiLine"
        android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/etImportLabel"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Wallet label (optional)"
        android:paddingStart="14dp" android:paddingEnd="14dp"/>
</LinearLayout>
