<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText android:id="@+id/etWalletLabel"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Wallet label (optional)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="16dp"/>

    <Button android:id="@+id/btnGenerateRandom"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Generate Random Wallet" android:textColor="@color/bg_primary"
        android:backgroundTint="@color/accent_cyan"
        style="@style/Widget.MaterialComponents.Button"/>

    <TextView android:id="@+id/tvGeneratedMnemonic"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/accent_green" android:textSize="12sp"
        android:fontFamily="monospace" android:padding="12dp"
        android:background="@drawable/bg_card" android:layout_marginTop="12dp"
        android:visibility="gone"/>
</LinearLayout>
