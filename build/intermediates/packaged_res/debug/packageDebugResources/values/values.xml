<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_blue">#3B82F6</color>
    <color name="accent_cyan">#00F2FF</color>
    <color name="accent_green">#10B981</color>
    <color name="accent_purple">#8B5CF6</color>
    <color name="bg_card">#1F242F</color>
    <color name="bg_input">#1A1F29</color>
    <color name="bg_primary">#0B0E14</color>
    <color name="bg_surface">#151921</color>
    <color name="border">#334155</color>
    <color name="colorAccent">@color/accent_cyan</color>
    <color name="colorPrimary">@color/accent_cyan</color>
    <color name="colorPrimaryDark">@color/bg_primary</color>
    <color name="divider">#1E293B</color>
    <color name="error_red">#EF4444</color>
    <color name="glass_border">#33FFFFFF</color>
    <color name="glass_white">#1AFFFFFF</color>
    <color name="text_hint">#475569</color>
    <color name="text_primary">#F1F5F9</color>
    <color name="text_secondary">#94A3B8</color>
    <color name="warning_orange">#F59E0B</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">M3R Wallet</string>
    <string name="nav_escrow">Escrow</string>
    <string name="nav_history">History</string>
    <string name="nav_home">Home</string>
    <string name="nav_settings">Settings</string>
    <style name="ActionBarTitleStyle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_cyan</item>
    </style>
    <style name="DialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="android:background">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    </style>
    <style name="InputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
    <style name="PinDot">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background">@drawable/pin_dot_empty</item>
    </style>
    <style name="PinKey" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/pin_key_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/accent_cyan</item>
        <item name="android:textColor">@color/bg_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="Theme.M3RWallet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/bg_primary</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>
    <style name="Theme.M3RWallet.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/bg_surface</item>
        <item name="titleTextStyle">@style/ActionBarTitleStyle</item>
    </style>
    <style name="Theme.M3RWallet.Splash" parent="Theme.M3RWallet">
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>
    <style name="Theme.M3RWallet.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.M3RWallet</item>
    </style>
    <style name="Theme.M3RWallet.WithActionBar" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/bg_primary</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="actionBarStyle">@style/Theme.M3RWallet.ActionBar</item>
        <item name="windowActionBar">true</item>
    </style>
</resources>