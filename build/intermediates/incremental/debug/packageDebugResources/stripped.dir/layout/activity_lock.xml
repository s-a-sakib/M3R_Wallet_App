<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg_primary"
    android:padding="24dp">

    <!-- Top spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Lock icon -->
    <TextView
        android:id="@+id/tvLockIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="48sp"
        android:layout_marginBottom="16dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Your PIN"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle / Error message -->
    <TextView
        android:id="@+id/tvLockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 6-digit PIN to unlock"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <!-- 6 PIN dots -->
    <LinearLayout
        android:id="@+id/dotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="40dp">

        <View android:id="@+id/dot1" style="@style/PinDot" />
        <View android:id="@+id/dot2" style="@style/PinDot" />
        <View android:id="@+id/dot3" style="@style/PinDot" />
        <View android:id="@+id/dot4" style="@style/PinDot" />
        <View android:id="@+id/dot5" style="@style/PinDot" />
        <View android:id="@+id/dot6" style="@style/PinDot" />
    </LinearLayout>

    <!-- Lockout timer -->
    <TextView
        android:id="@+id/tvLockout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/error_red"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Numeric Keypad 3x4 grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Row 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn1" style="@style/PinKey" android:text="1" />
            <Button android:id="@+id/btn2" style="@style/PinKey" android:text="2" />
            <Button android:id="@+id/btn3" style="@style/PinKey" android:text="3" />
        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn4" style="@style/PinKey" android:text="4" />
            <Button android:id="@+id/btn5" style="@style/PinKey" android:text="5" />
            <Button android:id="@+id/btn6" style="@style/PinKey" android:text="6" />
        </LinearLayout>

        <!-- Row 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn7" style="@style/PinKey" android:text="7" />
            <Button android:id="@+id/btn8" style="@style/PinKey" android:text="8" />
            <Button android:id="@+id/btn9" style="@style/PinKey" android:text="9" />
        </LinearLayout>

        <!-- Row 4: fingerprint, 0, backspace -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnFingerprint" style="@style/PinKey" android:text="👆" android:textSize="24sp" />
            <Button android:id="@+id/btn0" style="@style/PinKey" android:text="0" />
            <Button android:id="@+id/btnBackspace" style="@style/PinKey" android:text="⌫" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
