<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="Escrow"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:text="Create and manage on-chain escrow transactions"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <!-- Create Escrow -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardStyle"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:text="🔒  New Escrow"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:text="Lock funds with buyer/seller/arbiter"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <Button
                    android:id="@+id/btnCreateEscrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create Escrow"
                    style="@style/PrimaryButton"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Release Escrow -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardStyle"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:text="🔓  Release to Seller"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:text="Release escrowed funds to seller"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <Button
                    android:id="@+id/btnReleaseEscrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Release Escrow"
                    android:backgroundTint="@color/accent_green"
                    style="@style/PrimaryButton"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Refund Escrow -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardStyle"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:text="↩  Refund to Buyer"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:text="Refund escrowed funds back to buyer"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <Button
                    android:id="@+id/btnRefundEscrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Refund Escrow"
                    android:backgroundTint="@color/warning_orange"
                    style="@style/PrimaryButton"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Request Arbiter -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardStyle"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:text="⚖️  Request Arbiter"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:text="Request an arbiter for dispute resolution"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <Button
                    android:id="@+id/btnRequestArbiter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Request Arbiter"
                    style="@style/SecondaryButton"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/escrowProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/accent_cyan"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEscrowResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardStyle"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEscrowResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:padding="16dp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
