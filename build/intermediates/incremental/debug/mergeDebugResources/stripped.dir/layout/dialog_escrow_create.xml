<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <EditText android:id="@+id/etSellerAddress"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Seller address (Base58)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etArbiterAddress"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Arbiter address (Base58)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etEscrowAmount"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Amount (BDT)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="numberDecimal"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etExpiryHours"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Expiry in hours (default: 24)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="number"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etMetaInfo"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Meta info / order ID (optional)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true"/>
</LinearLayout>
