<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:id="@+id/tvEscrowActionTitle"
        android:text="Escrow Action" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etEscrowId"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Escrow ID (32-byte hex)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etActionToAddress"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="To address (Base58)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/etActionAmount"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" android:hint="Amount (BDT)"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="numberDecimal"/>
</LinearLayout>
